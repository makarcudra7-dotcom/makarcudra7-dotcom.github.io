{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/publish",
      "dest": "/api/publish.js"
    },
    {
      "src": "/",
      "dest": "https://makarcudra7-dotcom.github.io/",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "X-Provkus-Origin": "github-pages",
        "X-Provkus-Revive": "2026-09-25",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    },
    {
      "src": "/(?<path>.*)",
      "dest": "https://makarcudra7-dotcom.github.io/$path",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "X-Provkus-Origin": "github-pages",
        "X-Provkus-Revive": "2026-09-25",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  ]
}
