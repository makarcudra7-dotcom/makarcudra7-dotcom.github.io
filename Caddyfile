{
    admin off
    persist_config off
    auto_https off
    log {
        format json
    }
    servers {
        trusted_proxies static 0.0.0.0/0 ::/0
    }
}

:{$PORT:8080} {
    log {
        format json
    }

    root * .
    encode zstd gzip

    # HTML must always be revalidated so newly published materials appear immediately.
    @html {
        path / *.html
    }
    header @html Cache-Control "no-cache, must-revalidate"

    # Front-end code is versioned on public pages; keep a short cache while still
    # allowing fixes to propagate quickly when an unversioned legacy URL is used.
    @frontend {
        path *.js *.css
    }
    header @frontend Cache-Control "public, max-age=3600, must-revalidate"

    # Upload filenames and generated responsive variants are content-addressed by
    # article slug / size and do not change in place. Cache them aggressively so
    # navigation between lists, articles and World Cuisines does not re-download art.
    @images {
        path *.avif *.webp *.jpg *.jpeg *.png *.gif *.svg *.ico
    }
    header @images Cache-Control "public, max-age=31536000, immutable"

    @fonts {
        path *.woff *.woff2
    }
    header @fonts Cache-Control "public, max-age=31536000, immutable"

    file_server
}
